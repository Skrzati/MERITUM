# Skopiuj do infra/.env (robi to automatycznie `make up`). Plik .env NIE trafia do gita.
POSTGRES_DB=oceny
POSTGRES_USER=oceny
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
# LLM (OpenAI-compatible: Bielik / PLLuM). Tryb LIVE: LLM_API_KEY ustawiony (dla Ollama/LM Studio np. "ollama")
# albo LLM_LIVE=true dla endpointu bez klucza. Inaczej tryb MOCK (demo offline); błąd LLM -> MOCK_FALLBACK.
# Produkcja: wyłącznie modele na licencji Apache 2.0 (np. PLLuM-12B / Bielik), bez wariantów "-nc" (non-commercial).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_LIVE=false
LLM_MODEL=SpeakLeash/bielik-11b-v2.3-instruct

# Bezpieczeństwo backend-core
# Klucz HMAC do JWT (gov-login), min. 32 znaki, np.: openssl rand -base64 48. Pusty = losowy klucz do restartu (demo).
JWT_SECRET=
# Nagłówek X-Demo-User-Id (logowanie 1 kliknięciem, Swagger). W produkcji: false.
DEMO_HEADER_ENABLED=true
# Symulowane logowanie (POST /api/auth/gov-login). Domyślnie wyłączone; w produkcji false (login.gov.pl / konto lokalne).
GOV_LOGIN_ENABLED=true
# Próg k-anonimizacji statystyk (liczności 1..k-1 ukrywane po stronie serwera)
STATS_K_ANONYMITY=5
# Dozwolone originy CORS (wzorce, po przecinku). Przeglądarka i tak rozmawia z backendem przez proxy Next.js.
CORS_ALLOWED_ORIGINS=http://localhost:*
# Rate-limiting (okno 60 s): logowanie per adres klienta, AI per użytkownik; przekroczenie -> HTTP 429
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_WINDOW=30
RATE_LIMIT_AI_PER_WINDOW=60
# true: adres klienta z X-Forwarded-For (backend za proxy Next.js); false, gdy backend wystawiony bezpośrednio
RATE_LIMIT_TRUST_FORWARDED_FOR=true

# E-mail (SMTP). W demo Mailpit przechwytuje wiadomości — skrzynka: http://127.0.0.1:8025
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=meritum@kprm-demo.gov.pl
# Codzienne zbiorcze przypomnienia o terminach (cron Spring, strefa Europe/Warsaw); na żądanie: POST /api/hr/reminders/send-now
MAIL_REMINDERS_ENABLED=true
MAIL_REMINDERS_CRON=0 0 7 * * *
MAILPIT_UI_PORT=8025

# Retencja: nocne czyszczenie danych pomocniczych zamkniętych cykli (notatki robocze, ankiety) po karencji w dniach.
# Arkusze ocen (część B akt osobowych, 10/50 lat, legal hold) nigdy nie są usuwane.
RETENTION_PURGE_ENABLED=true
RETENTION_GRACE_DAYS=30
# Koszt BCrypt kont lokalnych (tryb Mały Urząd)
BCRYPT_STRENGTH=12
