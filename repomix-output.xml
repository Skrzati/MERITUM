# Skopiuj do infra/.env (robi to automatycznie `make up`). Plik .env NIE trafia do gita.
POSTGRES_DB=oceny
POSTGRES_USER=oceny
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_PORT=5432
BACKEND_PORT=8080
GOTENBERG_PORT=3001
AI_GATEWAY_PORT=8000
FRONTEND_PORT=3000
# LLM (OpenAI-compatible: Bielik / PLLuM). Tryb LIVE: LLM_API_KEY ustawiony (dla Ollama/LM Studio np. "ollama")
# albo LLM_LIVE=true dla endpointu bez klucza. Inaczej tryb MOCK (demo offline); błąd LLM -> MOCK_FALLBACK.
# Produkcja: wyłącznie modele na licencji Apache 2.0 (np. PLLuM-12B / Bielik), bez wariantów "-nc" (non-commercial).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_LIVE=false
LLM_MODEL=SpeakLeash/bielik-11b-v2.3-instruct

# Bezpieczeństwo backend-core
# Klucz HMAC do JWT (gov-login), min. 32 znaki, np.: openssl rand -base64 48. Pusty = losowy klucz do restartu (demo).
JWT_SECRET=
# Nagłówek X-Demo-User-Id (logowanie 1 kliknięciem, Swagger). W produkcji: false.
DEMO_HEADER_ENABLED=true
# Próg k-anonimizacji statystyk (liczności 1..k-1 ukrywane po stronie serwera)
STATS_K_ANONYMITY=5
