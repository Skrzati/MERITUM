    mode: str


class InterviewPrepRequest(BaseModel):
    employee_name: str
    sheet_type: Literal["A", "B", "C"]
    stage: Literal["INITIAL", "EVALUATION"]
    criteria_scores: List[CriterionScoreIn] = Field(default_factory=list)
    notes: List[str] = Field(default_factory=list)


