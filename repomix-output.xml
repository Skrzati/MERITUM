package pl.gov.kprm.oceny.rules;

import pl.gov.kprm.oceny.domain.EscalationLevel;

import java.time.LocalDate;
import java.time.temporal.ChronoUnit;

/** Termin oceny nie blokuje jej sporządzenia — opóźnienie jest liczone i eskalowane. */
public final class OverdueRules {
    private static final int EVALUATOR_MAX_DAYS = 7;
    private static final int DEPUTY_MAX_DAYS = 14;
    private static final int HR_MAX_DAYS = 30;

    private OverdueRules() {
    }

    /** Liczba dni po terminie (0, gdy termin nie minął lub ocena została już sporządzona). */
    public static long overdueDays(LocalDate dueDate, LocalDate today, boolean awaitingEvaluation) {
        if (!awaitingEvaluation || dueDate == null || !dueDate.isBefore(today)) {
            return 0;
        }
        return ChronoUnit.DAYS.between(dueDate, today);
    }

    public static EscalationLevel escalationLevel(long overdueDays) {
        if (overdueDays <= EVALUATOR_MAX_DAYS) return EscalationLevel.OCENIAJACY;
        if (overdueDays <= DEPUTY_MAX_DAYS) return EscalationLevel.ZASTEPCA;
        if (overdueDays <= HR_MAX_DAYS) return EscalationLevel.KADRY;
        return EscalationLevel.DYREKTOR_GENERALNY;
    }
}
</file>

<file path="backend-core/src/main/java/pl/gov/kprm/oceny/rules/PerformanceLevel.java">
package pl.gov.kprm.oceny.rules;

/** Poziomy wykonywania obowiązków wg średniej (§ 11). Górne granice są włączne. */
public enum PerformanceLevel {
    SIGNIFICANTLY_BELOW("znacznie poniżej oczekiwań", 2),
    BELOW("poniżej oczekiwań", 4),
    MEETS("na poziomie oczekiwań", 6),
    ABOVE("powyżej oczekiwań", 8),
    SIGNIFICANTLY_ABOVE("znacznie powyżej oczekiwań", 9);

    private final String label;
    private final int upperBound;

    PerformanceLevel(String label, int upperBound) {
        this.label = label;
        this.upperBound = upperBound;
    }

    /** Porównanie na liczbach całkowitych (sum <= granica * n) — dokładne, bez zaokrągleń średniej. */
    public static PerformanceLevel of(int sum, int count) {
        for (PerformanceLevel level : values()) {
            if (sum <= level.upperBound * count) {
                return level;
            }
        }
        throw new IllegalArgumentException("Średnia poza skalą");
    }

    public boolean isBelowExpectations() {
        return this == SIGNIFICANTLY_BELOW || this == BELOW;
    }

    public String label() {
        return label;
    }
}
</file>

<file path="backend-core/src/main/java/pl/gov/kprm/oceny/rules/RescheduleRules.java">
package pl.gov.kprm.oceny.rules;

import java.time.LocalDate;
import java.util.Optional;

/** Art. 81 ust. 8 ustawy o SC — warunek dopuszczalności zmiany terminu oceny. */
public final class RescheduleRules {
    private RescheduleRules() {
    }

    /**
     * Zmiana terminu jest dopuszczalna, gdy od sporządzenia ostatniej oceny upłynęło więcej niż 6 miesięcy,
     * a przy ocenie po raz pierwszy — gdy okres podlegający ocenie (do nowego terminu) jest dłuższy niż 6 miesięcy.
     *
     * @return komunikat naruszenia albo pusty, gdy zmiana jest dopuszczalna
     */
    public static Optional<String> violation(boolean firstEvaluation, LocalDate periodStart, LocalDate today,
                                             LocalDate newDueDate) {
        LocalDate sixMonths = periodStart.plusMonths(DeadlineService.SIX_MONTHS);
        if (firstEvaluation && !newDueDate.isAfter(sixMonths)) {
            return Optional.of("Przy pierwszej ocenie okres podlegający ocenie musi być dłuższy niż 6 miesięcy (art. 81 ust. 8)");
        }
        if (!firstEvaluation && !today.isAfter(sixMonths)) {
            return Optional.of("Zmiana terminu możliwa, gdy od ostatniej oceny upłynęło więcej niż 6 miesięcy (art. 81 ust. 8)");
        }
        return Optional.empty();
    }
}
