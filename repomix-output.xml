    open-in-view: false
    hibernate:
      ddl-auto: validate
    properties:
      hibernate.jdbc.time_zone: UTC
  flyway:
    enabled: true
    locations: classpath:db/migration
springdoc:
  swagger-ui:
    path: /swagger-ui.html
app:
  gotenberg-url: ${GOTENBERG_URL:http://localhost:3001/forms/chromium/convert/html}
  ai-gateway-url: ${AI_GATEWAY_URL:http://localhost:8000}
  jwt:
    # min. 32 bajty; pusty => losowy klucz na czas życia procesu (tylko demo)
