<file path="frontend/src/app/admin/page.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { RoleGate } from "@/components/RoleGate";
import { Alert, Badge, Button, Card, Field, inputClass, ProblemAlert, Spinner } from "@/components/ui";
import { useUser } from "@/components/UserProvider";
import { api, download } from "@/lib/api";
import { formatDate, today } from "@/lib/labels";
import type { Cycle, Schema, SchemaConfig, SheetType } from "@/lib/types";
import { useAsync } from "@/lib/useAsync";

const SHEETS: SheetType[] = ["A", "B", "C"];
const MAX_ADDITIONAL_LIMIT = 3;
const DEFAULT_MAX_ADDITIONAL = 3;
const CODE_PREFIX = "K";
const CODE_DIGITS = 2;

/** Wiersz kreatora — jedno kryterium katalogu z przypisaniem „obowiązkowe” dla arkuszy A/B/C. */
interface CriterionRow {
  code: string;
  name: string;
  /** Opisy zachowań — jedna linia = jeden opis. */
  description: string;
  mandatory: Record<SheetType, boolean>;
  added: boolean;
}

interface Draft {
  versionCode: string;
  effectiveFrom: string;
  periodMonths: number;
  maxAdditional: number;
  allowCustom: boolean;
  rows: CriterionRow[];
}

export default function AdminPage() {
  return (
    <RoleGate roles={["KPRM_ADMIN"]}>
      <SchemaAdmin />
    </RoleGate>
  );
}

function draftFrom(schema: Schema): Draft {
  const c = schema.config;
  return {
    versionCode: `${schema.versionCode}-nowelizacja`,
    effectiveFrom: today(),
    periodMonths: schema.periodMonths,
    maxAdditional: c.criteriaRules?.maxAdditional ?? DEFAULT_MAX_ADDITIONAL,
    allowCustom: c.criteriaRules?.allowCustom ?? false,
    rows: (c.criteria ?? []).map((k) => ({
      code: k.code,
      name: k.name,
      description: (k.description ?? []).join("\n"),
      mandatory: { A: false, B: false, C: false, ...Object.fromEntries(SHEETS.map((s) => [s, !!c.mandatoryBySheet?.[s]?.includes(k.code)])) },
      added: false,
    })),
  };
}

/** Konfiguracja wysyłana do backendu — pozostałe klucze (np. podstawa prawna) przejmowane z wersji bazowej. */
function configFrom(base: SchemaConfig, d: Draft): SchemaConfig {
  return {
    ...base,
    criteriaRules: { ...base.criteriaRules, maxAdditional: d.maxAdditional, allowCustom: d.allowCustom },
    criteria: d.rows.map((r) => {
      const description = r.description.split("\n").map((l) => l.trim()).filter(Boolean);
      return description.length ? { code: r.code, name: r.name.trim(), description } : { code: r.code, name: r.name.trim() };
    }),
    mandatoryBySheet: Object.fromEntries(SHEETS.map((s) => [s, d.rows.filter((r) => r.mandatory[s]).map((r) => r.code)])),
  };
}

function nextCode(rows: CriterionRow[]): string {
  const max = rows.reduce((m, r) => Math.max(m, Number(r.code.replace(/\D/g, "")) || 0), 0);
  return `${CODE_PREFIX}${String(max + 1).padStart(CODE_DIGITS, "0")}`;
}

function SchemaAdmin() {
  const { current } = useUser();
  const schemas = useAsync(() => api<Schema[]>("/api/admin/schemas"), [current?.id]);
  const cycles = useAsync(() => api<Cycle[]>("/api/cycles"), [current?.id]);
  const cyclesBySchema = (id: number) => (cycles.data ?? []).filter((c) => c.schemaVersionId === id).length;

  const latest = schemas.data?.[0];
  const [draft, setDraft] = useState<Draft | null>(null);
  const [busy, setBusy] = useState<string | null>(null);
  const [error, setError] = useState<unknown>(null);
  const [created, setCreated] = useState<Schema | null>(null);

  useEffect(() => {
    if (latest && !draft) setDraft(draftFrom(latest));
  }, [latest, draft]);

  const config = useMemo(() => (latest && draft ? configFrom(latest.config, draft) : null), [latest, draft]);

  const update = (patch: Partial<Draft>) => setDraft((d) => (d ? { ...d, ...patch } : d));
  const updateRow = (code: string, patch: Partial<CriterionRow>) =>
    setDraft((d) => (d ? { ...d, rows: d.rows.map((r) => (r.code === code ? { ...r, ...patch } : r)) } : d));
  const addRow = () =>
    setDraft((d) =>
      d ? { ...d, rows: [...d.rows, { code: nextCode(d.rows), name: "", description: "", mandatory: { A: false, B: false, C: false }, added: true }] } : d,
    );
  const removeRow = (code: string) => setDraft((d) => (d ? { ...d, rows: d.rows.filter((r) => r.code !== code) } : d));

  const downloadPackage = async (s: Schema) => {
    setBusy(`pkg-${s.id}`);
    setError(null);
    try {
      await download(`/api/admin/schemas/${s.id}/package`, `meritum-rules-${s.versionCode}.json`);
    } catch (e) {
      setError(e);
    } finally {
      setBusy(null);
    }
  };

  const create = async () => {
    if (!draft || !config) return;
    setBusy("create");
    setError(null);
    setCreated(null);
    try {
      setCreated(
        await api<Schema>("/api/admin/schemas", {
          body: { versionCode: draft.versionCode.trim(), effectiveFrom: draft.effectiveFrom, periodMonths: draft.periodMonths, config },
        }),
      );
      await schemas.reload();
    } catch (e) {
      setError(e);
    } finally {
      setBusy(null);
    }
  };

  const incomplete = !draft || !draft.versionCode.trim() || draft.periodMonths < 1 || draft.rows.some((r) => !r.name.trim());

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-gov-text">Prawo jako kod</h1>
        <p className="text-sm text-slate-700">Wersjonowane schematy oceny. Istniejące cykle zachowują swoją wersję schematu (§ 13).</p>
      </div>

      <Card title="Wersje schematu">
        {schemas.loading && <Spinner />}
        <ProblemAlert error={schemas.error} />
        <div className="overflow-x-auto">
          <table className="w-full text-left text-sm">
            <caption className="sr-only">Wersje schematu</caption>
            <thead className="border-b border-slate-200 text-xs uppercase text-slate-600">
              <tr>
                <th className="py-2 pr-3">Wersja</th>
                <th className="py-2 pr-3">Obowiązuje od</th>
                <th className="py-2 pr-3">Okres oceny</th>
                <th className="py-2 pr-3">Katalog kryteriów</th>
                <th className="py-2 pr-3">Obowiązkowe A / B / C</th>
                <th className="py-2 pr-3">Przypisane cykle</th>
                <th className="py-2" />
              </tr>
            </thead>
            <tbody>
              {(schemas.data ?? []).map((s) => {
                const m = s.config.mandatoryBySheet ?? {};
                return (
                  <tr key={s.id} className="border-b border-slate-100 last:border-0">
                    <td className="py-2 pr-3">
                      <Badge tone="blue">{s.versionCode}</Badge>
                    </td>
                    <td className="py-2 pr-3">{formatDate(s.effectiveFrom)}</td>
                    <td className="py-2 pr-3">{s.periodMonths} mies.</td>
                    <td className="py-2 pr-3">{s.config.criteria?.length ?? 0}</td>
                    <td className="py-2 pr-3">
                      {m.A?.length ?? 0} / {m.B?.length ?? 0} / {m.C?.length ?? 0}
                    </td>
                    <td className="py-2 pr-3">{cyclesBySchema(s.id)}</td>
                    <td className="py-2 text-right">
                      <Button variant="secondary" onClick={() => downloadPackage(s)} busy={busy === `pkg-${s.id}`}>
                        Pobierz pakiet reguł (.json)
                      </Button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </Card>

      {draft && latest && (
        <Card title="Kreator nowej wersji schematu">
          <p className="mb-4 text-sm text-slate-700">
            Formularz wypełniony na podstawie wersji <Badge tone="blue">{latest.versionCode}</Badge>. Zmiany obejmą wyłącznie nowe
            cykle; serwer waliduje katalog i kryteria obowiązkowe przed zapisem.
          </p>
          <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            <Field label="Kod wersji">
              <input className={inputClass} value={draft.versionCode} onChange={(e) => update({ versionCode: e.target.value })} />
            </Field>
            <Field label="Data wejścia w życie">
              <input type="date" className={inputClass} value={draft.effectiveFrom} onChange={(e) => update({ effectiveFrom: e.target.value })} />
            </Field>
            <Field label="Okres oceny (miesiące)" hint={`Obecnie: ${latest.periodMonths} mies.`}>
              <input
                type="number"
                min={1}
                className={inputClass}
                value={draft.periodMonths}
                onChange={(e) => update({ periodMonths: Number(e.target.value) })}
              />
            </Field>
            <Field label="Maks. kryteriów dodatkowych">
              <select className={inputClass} value={draft.maxAdditional} onChange={(e) => update({ maxAdditional: Number(e.target.value) })}>
                {Array.from({ length: MAX_ADDITIONAL_LIMIT + 1 }, (_, n) => (
                  <option key={n} value={n}>
                    {n}
                  </option>
                ))}
              </select>
            </Field>
            <label className="flex items-center gap-2 self-end pb-2 text-sm font-semibold text-gov-text">
              <input
                type="checkbox"
                className="h-4 w-4 accent-navy-700"
                checked={draft.allowCustom}
                onChange={(e) => update({ allowCustom: e.target.checked })}
              />
              Zezwól na kryteria własne
            </label>
          </div>

          <div className="mt-6 overflow-x-auto">
            <table className="w-full text-left text-sm">
              <caption className="mb-2 text-left text-sm font-semibold text-gov-text">
                Katalog kryteriów ({draft.rows.length}) · obowiązkowe A / B / C:{" "}
                {SHEETS.map((s) => draft.rows.filter((r) => r.mandatory[s]).length).join(" / ")}
              </caption>
              <thead className="border-b border-slate-200 text-xs uppercase text-slate-600">
                <tr>
                  <th className="py-2 pr-3">Kod</th>
                  <th className="py-2 pr-3">Nazwa</th>
                  <th className="py-2 pr-3">Opis zachowań (jedna linia = jeden opis)</th>
                  <th className="py-2 pr-3 text-center">Obowiązkowe dla arkusza</th>
                  <th className="py-2" />
                </tr>
              </thead>
              <tbody>
                {draft.rows.map((r) => (
                  <tr key={r.code} className="border-b border-slate-100 align-top last:border-0">
                    <td className="py-2 pr-3 font-mono text-xs">{r.code}</td>
                    <td className="py-2 pr-3">
                      <input
                        aria-label={`Nazwa kryterium ${r.code}`}
                        className={inputClass}
                        value={r.name}
                        onChange={(e) => updateRow(r.code, { name: e.target.value })}
                      />
                    </td>
                    <td className="py-2 pr-3">
                      <textarea
                        aria-label={`Opis zachowań ${r.code}`}
                        className={`${inputClass} text-xs`}
                        rows={2}
                        value={r.description}
                        onChange={(e) => updateRow(r.code, { description: e.target.value })}
                      />
                    </td>
                    <td className="py-2 pr-3">
                      <div className="flex justify-center gap-3">
                        {SHEETS.map((s) => (
                          <label key={s} className="flex flex-col items-center text-xs font-semibold">
                            <input
                              type="checkbox"
                              aria-label={`${r.code} obowiązkowe dla arkusza ${s}`}
                              className="h-4 w-4 accent-navy-700"
                              checked={r.mandatory[s]}
                              onChange={(e) => updateRow(r.code, { mandatory: { ...r.mandatory, [s]: e.target.checked } })}
                            />
                            [{s}]
                          </label>
                        ))}
                      </div>
                    </td>
                    <td className="py-2 text-right">
                      {r.added && (
                        <Button variant="secondary" onClick={() => removeRow(r.code)} aria-label={`Usuń kryterium ${r.code}`}>
                          Usuń
                        </Button>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div className="mt-3">
            <Button variant="secondary" onClick={addRow}>
              + Dodaj kryterium
            </Button>
          </div>

          <details className="mt-6 rounded border border-dashed border-slate-400">
            <summary className="cursor-pointer px-3 py-2 text-sm font-semibold text-gov-blue focus:outline-none focus-visible:ring-2 focus-visible:ring-gov-blue">
              Podgląd techniczny JSON (dla IT)
            </summary>
            <pre className="max-h-96 overflow-auto whitespace-pre-wrap border-t border-slate-200 bg-gov-section px-3 py-2 font-mono text-xs">
              {JSON.stringify(
                { versionCode: draft.versionCode, effectiveFrom: draft.effectiveFrom, periodMonths: draft.periodMonths, config },
                null,
                2,
              )}
            </pre>
          </details>

          <div className="mt-4 space-y-3">
            <Button onClick={create} busy={busy === "create"} disabled={incomplete}>
              Utwórz wersję schematu
            </Button>
            {incomplete && <p className="text-xs text-slate-600">Uzupełnij kod wersji, okres oceny i nazwy wszystkich kryteriów.</p>}
            <ProblemAlert error={error} />
            {created && (
              <Alert tone="green" title={`Utworzono ${created.versionCode} (${created.periodMonths} mies.)`}>
                Istniejące cykle pozostają przy dotychczasowej wersji — zgodnie z § 13 nowa wersja dotyczy wyłącznie nowych cykli.
              </Alert>
            )}
          </div>
        </Card>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/app/audit/page.tsx">
"use client";

import { useState } from "react";
import { RoleGate } from "@/components/RoleGate";
import { Alert, Badge, Card, MaskedPrompt, ModeBadge, ProblemAlert, Spinner } from "@/components/ui";
import { useUser } from "@/components/UserProvider";
import { api } from "@/lib/api";
import type { AiMode, AuditLogItem } from "@/lib/types";
import { useAsync } from "@/lib/useAsync";

const AUDIT_LIMIT = 100;
const AI_PREFIX = "AI_";
const AI_MODES: AiMode[] = ["LIVE", "MOCK", "MOCK_FALLBACK"];

export default function AuditPage() {
  return (
    <RoleGate roles={["HR", "DG", "KPRM_ADMIN"]}>
      <Audit />
    </RoleGate>
  );
}

const isAi = (l: AuditLogItem) => l.action.startsWith(AI_PREFIX);

function aiMode(l: AuditLogItem): AiMode | null {
  const mode = l.payload?.mode;
  return typeof mode === "string" && (AI_MODES as string[]).includes(mode) ? (mode as AiMode) : null;
}

function maskedPrompt(l: AuditLogItem): string | null {
  const prompt = l.payload?.maskedPrompt;
  return typeof prompt === "string" && prompt ? prompt : null;
}

function Audit() {
  const { current, userName } = useUser();
  const logs = useAsync(() => api<AuditLogItem[]>(`/api/audit-logs?limit=${AUDIT_LIMIT}`), [current?.id]);
  const [aiOnly, setAiOnly] = useState(false);
  const all = logs.data ?? [];
  const visible = aiOnly ? all.filter(isAi) : all;

  return (
    <div className="space-y-6">
      <h1 className="text-2xl font-bold text-gov-text">Dziennik audytu</h1>
      <Alert tone="blue">
        Każda zmiana stanu cyklu, eksport i wywołanie AI są rejestrowane (AI Act art. 26). W audycie AI zapisywany jest wyłącznie
        prompt po maskowaniu PII.
      </Alert>
      <Card
        title={`Ostatnie zdarzenia (do ${AUDIT_LIMIT})`}
        actions={
          <label className="flex items-center gap-2 text-sm font-semibold text-gov-text">
            <input type="checkbox" className="h-4 w-4 accent-navy-700" checked={aiOnly} onChange={(e) => setAiOnly(e.target.checked)} />
            Tylko interakcje AI (AI Act art. 26) · {all.filter(isAi).length}
          </label>
        }
      >
        {logs.loading && <Spinner />}
        <ProblemAlert error={logs.error} />
        {logs.data && visible.length === 0 && <p className="text-sm text-slate-700">Brak zdarzeń.</p>}
        {visible.length > 0 && (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-sm">
              <caption className="sr-only">Zdarzenia audytowe</caption>
              <thead className="border-b border-slate-200 text-xs uppercase text-slate-600">
                <tr>
                  <th className="py-2 pr-4">Czas</th>
                  <th className="py-2 pr-4">Zdarzenie</th>
                  <th className="py-2 pr-4">Wykonawca</th>
                  <th className="py-2 pr-4">Obiekt</th>
                  <th className="py-2">Szczegóły</th>
                </tr>
              </thead>
              <tbody>
                {visible.map((l) => {
                  const mode = aiMode(l);
                  const prompt = maskedPrompt(l);
                  return (
                    <tr key={l.id} className="border-b border-slate-100 align-top last:border-0">
                      <td className="whitespace-nowrap py-2 pr-4">{new Date(l.createdAt).toLocaleString("pl-PL")}</td>
                      <td className="py-2 pr-4">
                        <div className="flex flex-wrap gap-1">
                          <Badge tone={isAi(l) ? "blue" : "slate"}>{l.action}</Badge>
                          {mode && <ModeBadge mode={mode} />}
                        </div>
                      </td>
                      <td className="py-2 pr-4">{userName(l.actorId)}</td>
                      <td className="py-2 pr-4">
                        {l.entityType}
                        {l.entityId !== null ? ` #${l.entityId}` : ""}
                      </td>
                      <td className="w-1/2 space-y-2 py-2">
                        {prompt && <MaskedPrompt prompt={prompt} />}
                        {l.payload && Object.keys(l.payload).length > 0 && (
                          <details>
                            <summary className="cursor-pointer text-sm font-semibold text-gov-blue">Payload (JSON)</summary>
                            <pre className="mt-1 max-h-72 overflow-auto whitespace-pre-wrap rounded bg-gov-section p-2 font-mono text-xs">
                              {JSON.stringify(l.payload, null, 2)}
                            </pre>
                          </details>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </Card>
    </div>
  );
}
</file>

<file path="frontend/src/app/hr/page.tsx">
"use client";

import Link from "next/link";
import { useRef, useState } from "react";
import { RoleGate } from "@/components/RoleGate";
import { Alert, Badge, Button, Card, Field, inputClass, ProblemAlert, Spinner } from "@/components/ui";
import { useUser } from "@/components/UserProvider";
import { api, download, saveBlob } from "@/lib/api";
import { formatDate, ROLE_LABEL, today, type Tone } from "@/lib/labels";
import type { Cycle, EscalationLevel, HandoverResult, ImportResult, OverdueItem, User } from "@/lib/types";
import { useAsync } from "@/lib/useAsync";

type SortKey = "fullName" | "email" | "role" | "id";

/** Drabina eskalacji (OverdueRules): 1–7 dni oceniający, 8–14 zastępca, 15–30 kadry, > 30 DG. */
const ESCALATION: Record<EscalationLevel, { label: string; tone: Tone }> = {
  OCENIAJACY: { label: "Oceniający (1–7 dni)", tone: "blue" },
  ZASTEPCA: { label: "Zastępca (8–14 dni)", tone: "amber" },
  KADRY: { label: "Kadry (15–30 dni)", tone: "amber" },
  DYREKTOR_GENERALNY: { label: "Dyrektor Generalny (> 30 dni)", tone: "red" },
};

export default function HrPage() {
  return (
    <RoleGate roles={["HR"]}>
      <HrPanel />
    </RoleGate>
  );
}

function HrPanel() {
  const { current, reloadUsers } = useUser();
  const [query, setQuery] = useState("");
  const [sort, setSort] = useState<SortKey>("fullName");
  const [dir, setDir] = useState<"ASC" | "DESC">("ASC");
  const employees = useAsync(
    () => api<User[]>(`/api/hr/employees?q=${encodeURIComponent(query)}&sort=${sort}&dir=${dir}`),
    [query, sort, dir, current?.id],
  );
  const list = employees.data ?? [];

  const [exportError, setExportError] = useState<unknown>(null);
  const gdprExport = async (u: User) => {
    setExportError(null);
    try {
      const data = await api<unknown>(`/api/hr/employees/${u.id}/gdpr-export`);
      saveBlob(new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }), `rodo-art15-${u.id}.json`);
    } catch (e) {
      setExportError(e);
    }
  };

  const overdue = useAsync(() => api<OverdueItem[]>("/api/hr/overdue"), [current?.id]);
  const [handoverEmployeeId, setHandoverEmployeeId] = useState("");
  const handoverRef = useRef<HTMLDivElement>(null);
  const [reportBusy, setReportBusy] = useState(false);

  const refreshAll = async () => {
    await Promise.all([employees.reload(), reloadUsers(), overdue.reload()]);
  };

  const changeEvaluator = (employeeId: number) => {
    setHandoverEmployeeId(String(employeeId));
    handoverRef.current?.scrollIntoView({ behavior: "smooth", block: "center" });
    handoverRef.current?.querySelector<HTMLSelectElement>("select[data-new-evaluator]")?.focus({ preventScroll: true });
  };

  const downloadReport = async () => {
    setReportBusy(true);
    setExportError(null);
    try {
      await download("/api/hr/reports/export", `raport-ocen-${today()}.csv`);
    } catch (e) {
      setExportError(e);
    } finally {
      setReportBusy(false);
    }
  };

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-gov-text">Panel Kadr</h1>
          <p className="text-sm text-slate-700">Raport sprawozdawczy jest zanonimizowany (k-anonimizacja po stronie serwera, UTF-8 dla Excela).</p>
        </div>
        <Button variant="secondary" onClick={downloadReport} busy={reportBusy}>
          ⬇ Pobierz raport sprawozdawczy (CSV)
        </Button>
      </div>

      <Card title="Zaległości i drabina eskalacji">
        <p className="mb-3 text-sm text-slate-700">
          Ocena po terminie nie jest blokowana — system liczy dni opóźnienia i wskazuje szczebel eskalacji.
        </p>
        {overdue.loading && <Spinner />}
        <ProblemAlert error={overdue.error} />
        {overdue.data && overdue.data.length === 0 && <Alert tone="green">Brak cykli po terminie.</Alert>}
        {overdue.data && overdue.data.length > 0 && (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-sm">
              <caption className="sr-only">Cykle po terminie</caption>
              <thead className="border-b border-slate-200 text-xs uppercase text-slate-600">
                <tr>
                  <th className="py-2 pr-3">Oceniany</th>
                  <th className="py-2 pr-3">Oceniający</th>
                  <th className="py-2 pr-3">Termin</th>
                  <th className="py-2 pr-3">Dni po terminie</th>
                  <th className="py-2 pr-3">Powód opóźnienia</th>
                  <th className="py-2 pr-3">Szczebel eskalacji</th>
                  <th className="py-2" />
                </tr>
              </thead>
              <tbody>
                {overdue.data.map((o) => (
                  <tr key={o.cycleId} className="border-b border-slate-100 align-top last:border-0">
                    <td className="py-2 pr-3 font-medium">
                      <Link href={`/cycles/${o.cycleId}`} className="text-gov-blue underline">
                        {o.employeeName ?? `#${o.employeeId}`}
                      </Link>
                    </td>
                    <td className="py-2 pr-3">{o.evaluatorName ?? `#${o.evaluatorId}`}</td>
                    <td className="py-2 pr-3">{formatDate(o.dueDate)}</td>
                    <td className="py-2 pr-3 font-bold text-red-800">{o.overdueDays}</td>
                    <td className="py-2 pr-3">{o.delayReason ?? <span className="text-slate-500">nie podano</span>}</td>
                    <td className="py-2 pr-3">
                      <Badge tone={ESCALATION[o.escalationLevel].tone}>{ESCALATION[o.escalationLevel].label}</Badge>
                    </td>
                    <td className="py-2 text-right">
                      <Button variant="secondary" onClick={() => changeEvaluator(o.employeeId)}>
                        Zmień oceniającego
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </Card>

      <Card title="Pracownicy urzędu">
        <div className="mb-4 grid gap-3 sm:grid-cols-3">
          <Field label="Szukaj (imię, nazwisko, e-mail)">
            <input type="search" className={inputClass} value={query} onChange={(e) => setQuery(e.target.value)} />
          </Field>
          <Field label="Sortuj według">
            <select className={inputClass} value={sort} onChange={(e) => setSort(e.target.value as SortKey)}>
              <option value="fullName">Imię i nazwisko</option>
              <option value="email">E-mail</option>
              <option value="role">Rola</option>
              <option value="id">ID</option>
            </select>
          </Field>
          <Field label="Kierunek">
            <select className={inputClass} value={dir} onChange={(e) => setDir(e.target.value as "ASC" | "DESC")}>
              <option value="ASC">rosnąco</option>
              <option value="DESC">malejąco</option>
            </select>
          </Field>
        </div>
        {employees.loading && <Spinner />}
        <ProblemAlert error={employees.error ?? exportError} />
        <div className="overflow-x-auto">
          <table className="w-full text-left text-sm">
            <caption className="sr-only">Pracownicy</caption>
            <thead className="border-b border-slate-200 text-xs uppercase text-slate-600">
              <tr>
                <th className="py-2 pr-3">Imię i nazwisko</th>
                <th className="py-2 pr-3">E-mail</th>
                <th className="py-2 pr-3">Rola</th>
                <th className="py-2 pr-3">Status SC</th>
                <th className="py-2" />
              </tr>
            </thead>
            <tbody>
              {list.map((u) => (
                <tr key={u.id} className="border-b border-slate-100 last:border-0">
                  <td className="py-2 pr-3 font-medium">{u.fullName}</td>
                  <td className="py-2 pr-3">{u.email}</td>
                  <td className="py-2 pr-3">{ROLE_LABEL[u.role]}</td>
                  <td className="py-2 pr-3">{u.civilServant ? <Badge tone="blue">urzędnik SC</Badge> : <Badge>pracownik SC</Badge>}</td>
                  <td className="py-2 text-right">
                    <Button variant="secondary" onClick={() => gdprExport(u)}>
                      Eksport RODO (art. 15)
                    </Button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>

      <div className="grid gap-6 lg:grid-cols-3">
        <AbsenceForm employees={list} />
        <div ref={handoverRef} id="handover">
          <HandoverForm employees={list} employeeId={handoverEmployeeId} onEmployeeChange={setHandoverEmployeeId} onDone={refreshAll} />
        </div>
        <CsvImport onDone={refreshAll} />
      </div>
    </div>
  );
}

function AbsenceForm({ employees }: { employees: User[] }) {
  const [userId, setUserId] = useState("");
  const [start, setStart] = useState(today());
  const [end, setEnd] = useState(today());
  const [reason, setReason] = useState("Zwolnienie lekarskie");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<unknown>(null);
  const [cycles, setCycles] = useState<Cycle[] | null>(null);

  const submit = async () => {
    setBusy(true);
    setError(null);
    try {
      setCycles(await api<Cycle[]>("/api/hr/absences", { body: { userId: Number(userId), startDate: start, endDate: end, reason } }));
    } catch (e) {
      setError(e);
    } finally {
      setBusy(false);
    }
  };

  return (
    <Card title="Rejestracja nieobecności">
      <div className="space-y-3">
        <EmployeeSelect employees={employees} value={userId} onChange={setUserId} />
        <div className="grid grid-cols-2 gap-2">
          <Field label="Od">
            <input type="date" className={inputClass} value={start} onChange={(e) => setStart(e.target.value)} />
          </Field>
          <Field label="Do">
            <input type="date" className={inputClass} value={end} onChange={(e) => setEnd(e.target.value)} />
          </Field>
        </div>
        <Field label="Przyczyna">
          <input className={inputClass} value={reason} onChange={(e) => setReason(e.target.value)} />
        </Field>
        <p className="text-xs text-slate-600">Ciągła nieobecność dłuższa niż 1 miesiąc przedłuża termin oceny okresowej (art. 81 ust. 7).</p>
        <Button onClick={submit} busy={busy} disabled={!userId}>
          Zarejestruj i przelicz termin
        </Button>
        <ProblemAlert error={error} />
        {cycles && (
          <Alert tone="green" title="Przeliczone terminy aktywnych cykli">
            {cycles.length === 0 ? "Brak aktywnych cykli." : cycles.map((c) => <p key={c.id}>Cykl #{c.id}: nowy termin {formatDate(c.dueDate)}</p>)}
          </Alert>
        )}
      </div>
    </Card>
  );
}

function HandoverForm({
  employees,
  employeeId,
  onEmployeeChange,
  onDone,
}: {
  employees: User[];
  employeeId: string;
  onEmployeeChange: (id: string) => void;
  onDone: () => Promise<void>;
}) {
  const [evaluatorId, setEvaluatorId] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<unknown>(null);
  const [result, setResult] = useState<HandoverResult | null>(null);
  const evaluators = employees.filter((u) => u.role === "EVALUATOR" || u.role === "DG");

  const submit = async () => {
    setBusy(true);
    setError(null);
    try {
      setResult(await api<HandoverResult>("/api/hr/handover", { body: { employeeId: Number(employeeId), newEvaluatorId: Number(evaluatorId) } }));
      await onDone();
    } catch (e) {
      setError(e);
    } finally {
      setBusy(false);
    }
  };

  return (
    <Card title="Zmiana przełożonego (Handover)">
      <div className="space-y-3">
        <EmployeeSelect employees={employees} value={employeeId} onChange={onEmployeeChange} />
        <Field label="Nowy oceniający">
          <select data-new-evaluator className={inputClass} value={evaluatorId} onChange={(e) => setEvaluatorId(e.target.value)}>
            <option value="">— wybierz —</option>
            {evaluators.map((u) => (
              <option key={u.id} value={u.id}>
                {u.fullName} ({ROLE_LABEL[u.role]})
              </option>
            ))}
          </select>
        </Field>
        <p className="text-xs text-slate-600">§ 9 ust. 3: nowy przełożony przejmuje aktywny cykl i notatki, kryteria pozostają bez zmian.</p>
        <Button onClick={submit} busy={busy} disabled={!employeeId || !evaluatorId}>
          Przekaż cykl
        </Button>
        <ProblemAlert error={error} />
        {result && (
          <Alert tone="green" title="Przekazano">
            Cykle: {result.cycleIds.length ? result.cycleIds.map((id) => `#${id}`).join(", ") : "brak aktywnych"} · notatek: {result.notesTransferred}
          </Alert>
        )}
      </div>
    </Card>
  );
}

function CsvImport({ onDone }: { onDone: () => Promise<void> }) {
  const [file, setFile] = useState<File | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<unknown>(null);
  const [result, setResult] = useState<ImportResult | null>(null);

  const submit = async () => {
    if (!file) return;
    setBusy(true);
    setError(null);
    try {
      const form = new FormData();
      form.append("file", file);
      setResult(await api<ImportResult>("/api/hr/import-csv", { form }));
      await onDone();
    } catch (e) {
      setError(e);
    } finally {
      setBusy(false);
    }
  };

  return (
    <Card title="Import pracowników (CSV)">
      <div className="space-y-3">
        <Field label="Plik CSV" hint="Kolumny: full_name,email,role,is_civil_servant[,supervisor_email]">
          <input type="file" accept=".csv,text/csv" className="block w-full text-sm" onChange={(e) => setFile(e.target.files?.[0] ?? null)} />
        </Field>
        <Button onClick={submit} busy={busy} disabled={!file}>
          Importuj
        </Button>
        <ProblemAlert error={error} />
        {result && (
          <Alert tone={result.errors.length ? "amber" : "green"} title={`Zaimportowano: ${result.imported}`}>
            {[...result.skipped, ...result.errors].map((m) => (
              <p key={m}>{m}</p>
            ))}
          </Alert>
        )}
      </div>
    </Card>
  );
}

function EmployeeSelect({ employees, value, onChange }: { employees: User[]; value: string; onChange: (v: string) => void }) {
  return (
    <Field label="Pracownik">
      <select className={inputClass} value={value} onChange={(e) => onChange(e.target.value)}>
        <option value="">— wybierz —</option>
        {employees.map((u) => (
          <option key={u.id} value={u.id}>
            {u.fullName}
          </option>
        ))}
      </select>
    </Field>
  );
}
