<file path="frontend/src/components/cycle/CriteriaTab.tsx">
"use client";

import { useState } from "react";
import { Alert, Badge, Button, Card, ProblemAlert } from "@/components/ui";
import { api } from "@/lib/api";
import type { Cycle } from "@/lib/types";
import type { CycleView } from "./context";

const DEFAULT_MAX_ADDITIONAL = 3;

export function CriteriaTab({ view }: { view: CycleView }) {
  const { cycle, schema, isEvaluator, isEmployee, refresh } = view;
  const editable = isEvaluator && cycle.status === "DRAFT_CRITERIA";
  const catalog = schema?.config.criteria ?? [];
  const mandatoryCodes = schema?.config.mandatoryBySheet?.[cycle.sheetType] ?? [];
  const maxAdditional = schema?.config.criteriaRules?.maxAdditional ?? DEFAULT_MAX_ADDITIONAL;
  const nameOf = (code: string) => catalog.find((c) => c.code === code)?.name ?? code;

  const [selected, setSelected] = useState<string[]>(
    (cycle.criteria ?? []).filter((c) => !c.mandatory).map((c) => c.code),
  );
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<unknown>(null);
  const [saved, setSaved] = useState(false);

  const toggle = (code: string) =>
    setSelected((s) => (s.includes(code) ? s.filter((c) => c !== code) : s.length < maxAdditional ? [...s, code] : s));

  const run = async (fn: () => Promise<unknown>) => {
    setBusy(true);
    setError(null);
    setSaved(false);
    try {
      await fn();
      setSaved(true);
      await refresh();
    } catch (e) {
      setError(e);
    } finally {
      setBusy(false);
    }
  };

  const save = () =>
    run(() => api<Cycle>(`/api/cycles/${cycle.id}/criteria`, { body: { additional: selected.map((code) => ({ code })) } }));
  const confirm = () => run(() => api<Cycle>(`/api/cycles/${cycle.id}/confirm-criteria`, { method: "POST" }));

  return (
    <div className="grid gap-6 lg:grid-cols-2">
      <Card title="Kryteria arkusza">
        {cycle.criteria?.length ? (
          <ol className="space-y-2">
            {cycle.criteria.map((c, i) => (
              <li key={c.code} className="flex items-center justify-between gap-3 rounded border border-slate-200 px-3 py-2 text-sm">
                <span>
                  <span className="mr-2 font-mono text-xs text-slate-600">{i + 1}.</span>
                  {c.name} <span className="font-mono text-xs text-slate-600">({c.code})</span>
                </span>
                <Badge tone={c.mandatory ? "blue" : "slate"}>{c.mandatory ? "obowiązkowe" : "dodatkowe"}</Badge>
              </li>
            ))}
          </ol>
        ) : (
          <Alert tone="amber">Kryteria nie zostały jeszcze ustalone przez oceniającego.</Alert>
        )}

        {cycle.status !== "DRAFT_CRITERIA" && cycle.criteria?.length ? (
          <p className="mt-4 text-sm text-slate-700">🔒 Kryteria zostały potwierdzone i są zablokowane do końca cyklu.</p>
        ) : null}

        {isEmployee && cycle.status === "DRAFT_CRITERIA" && (
          <div className="mt-4 space-y-2">
            <Button onClick={confirm} busy={busy} disabled={!cycle.criteria?.length}>
              Potwierdź zapoznanie z kryteriami
            </Button>
            <p className="text-xs text-slate-600">Po potwierdzeniu kryteria zostaną zablokowane, a cykl przejdzie do etapu obserwacji.</p>
          </div>
        )}
        <div className="mt-4 space-y-2">
          <ProblemAlert error={error} />
          {saved && !error && <Alert tone="green">Zapisano.</Alert>}
        </div>
      </Card>

      {editable && (
        <Card title={`Wybór kryteriów (arkusz ${cycle.sheetType})`}>
          <p className="mb-2 text-sm font-medium text-slate-800">Obowiązkowe dla arkusza {cycle.sheetType} (§ 4):</p>
          <ul className="mb-4 flex flex-wrap gap-2">
            {mandatoryCodes.map((code) => (
              <li key={code}>
                <Badge tone="blue">
                  {code} · {nameOf(code)}
                </Badge>
              </li>
            ))}
          </ul>
          <fieldset>
            <legend className="mb-2 text-sm font-medium text-slate-800">
              Dodatkowe z katalogu (załącznik nr 1) — wybrano {selected.length}/{maxAdditional}
            </legend>
            <div className="grid gap-1 sm:grid-cols-2">
              {catalog
                .filter((c) => !mandatoryCodes.includes(c.code))
                .map((c) => {
                  const checked = selected.includes(c.code);
                  const disabled = !checked && selected.length >= maxAdditional;
                  return (
                    <label
                      key={c.code}
                      className={`flex items-start gap-2 rounded px-2 py-1.5 text-sm ${disabled ? "text-slate-500" : "hover:bg-slate-50"}`}
                    >
                      <input
                        type="checkbox"
                        className="mt-0.5 h-4 w-4 accent-navy-700"
                        checked={checked}
                        disabled={disabled}
                        onChange={() => toggle(c.code)}
                      />
                      <span>
                        <span className="font-mono text-xs">{c.code}</span> {c.name}
                      </span>
                    </label>
                  );
                })}
            </div>
          </fieldset>
          <div className="mt-4">
            <Button onClick={save} busy={busy}>
              Zapisz kryteria
            </Button>
          </div>
        </Card>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/components/cycle/EvaluationTab.tsx">
"use client";

import { useState } from "react";
import { AiDisclaimer, Alert, Badge, Button, Card, Field, inputClass, MaskedPrompt, ModeBadge, ProblemAlert } from "@/components/ui";
import { useUser } from "@/components/UserProvider";
import { api } from "@/lib/api";
import { LEVEL_LABEL, OUTCOME_LABEL, previewAverage } from "@/lib/labels";
import type { ConsistencyResponse, EvaluationResponse, EvaluationResult, SocraticResponse } from "@/lib/types";
import type { CycleView } from "./context";
import { ScorePicker } from "./ScorePicker";

const EDITABLE = ["OBSERVATION", "EVALUATION_DRAFT"];

export function EvaluationTab({ view }: { view: CycleView }) {
  const { cycle, notes, employee, isEvaluator, refresh } = view;
  const { userName } = useUser();
  const criteria = cycle.criteria ?? [];
  const editable = isEvaluator && EDITABLE.includes(cycle.status);
  const civilServant = employee?.civilServant ?? false;

  const [scores, setScores] = useState<Record<string, number>>(cycle.scores ?? {});
  const [justification, setJustification] = useState(cycle.justification ?? "");
  const [iprz, setIprz] = useState(cycle.iprzNotes ?? "");
  const [gradeRequested, setGradeRequested] = useState(cycle.gradeRequest?.requested ?? false);
  const [motivation, setMotivation] = useState(cycle.gradeRequest?.motivation ?? "");
  const [gender, setGender] = useState("");

  const [busy, setBusy] = useState<string | null>(null);
  const [error, setError] = useState<unknown>(null);
  const [result, setResult] = useState<EvaluationResult | null>(null);
  const [draftSaved, setDraftSaved] = useState(false);
  const [socratic, setSocratic] = useState<SocraticResponse | null>(null);
  const [consistency, setConsistency] = useState<ConsistencyResponse | null>(null);

  const average = previewAverage(criteria.map((c) => scores[c.code]));

  const run = async (key: string, fn: () => Promise<void>) => {
    setBusy(key);
    setError(null);
    try {
      await fn();
    } catch (e) {
      setError(e);
    } finally {
      setBusy(null);
    }
  };

  const evaluate = (submit: boolean) =>
    run(submit ? "submit" : "draft", async () => {
      setDraftSaved(false);
      const res = await api<EvaluationResponse>(`/api/cycles/${cycle.id}/evaluate`, {
        method: "PUT",
        body: {
          scores,
          justification,
          iprzNotes: iprz,
          gradeRequest: civilServant && gradeRequested ? { requested: true, motivation } : null,
          submit,
        },
      });
      setResult(res.result);
      setDraftSaved(!submit);
      await refresh();
    });

  const askSocratic = () =>
    run("socratic", async () => {
      setSocratic(
        await api<SocraticResponse>("/api/ai/socratic-draft", {
          body: {
            employee_name: userName(cycle.employeeId),
            sheet_type: cycle.sheetType,
            criteria_scores: criteria.map((c) => ({ code: c.code, name: c.name, score: scores[c.code] ?? null })),
            notes: (notes ?? []).map((n) => n.content),
          },
        }),
      );
    });

  const checkConsistency = () =>
    run("consistency", async () => {
      setConsistency(
        await api<ConsistencyResponse>("/api/ai/consistency-check", {
          body: {
            employee_name: userName(cycle.employeeId),
            employee_gender: gender || null,
            criteria_part1: criteria.map((c) => c.name),
            criteria_part2: criteria.filter((c) => scores[c.code] !== undefined).map((c) => c.name),
            average_score: Number(average ?? cycle.averageScore ?? 5),
            level: null,
            justification,
            grade_request_text: civilServant && gradeRequested ? motivation : null,
          },
        }),
      );
    });

  if (!criteria.length) return <Alert tone="amber">Najpierw należy ustalić i potwierdzić kryteria oceny.</Alert>;

  return (
    <div className="grid gap-6 xl:grid-cols-5">
      <div className="space-y-6 xl:col-span-3">
        <Card
          title="Część II — oceny cząstkowe"
          actions={
            <div className="text-right text-sm">
              <span className="text-slate-700">Średnia (podgląd): </span>
              <strong className="text-lg text-navy-900">{average ?? "—"}</strong>
            </div>
          }
        >
          {!editable && (
            <p className="mb-3 text-sm text-slate-700">
              {isEvaluator ? "Ocena jest zablokowana na tym etapie procesu." : "Podgląd — ocenę wypełnia oceniający."}
            </p>
          )}
          <ScorePicker criteria={criteria} scores={scores} disabled={!editable} onChange={(code, v) => setScores((s) => ({ ...s, [code]: v }))} />
          <p className="mt-2 text-xs text-slate-600">
            Wynik wiążący (poziom, ocena pozytywna/negatywna) wylicza silnik reguł § 11 po zatwierdzeniu. Ocena 1 pkt w dowolnym kryterium oznacza ocenę negatywną.
          </p>
        </Card>

        <Card title="Uzasadnienie i IPRZ">
          <div className="space-y-4">
            <Field label="Uzasadnienie oceny" hint="Obowiązkowe przy ocenie negatywnej.">
              <textarea className={inputClass} rows={6} value={justification} disabled={!editable} onChange={(e) => setJustification(e.target.value)} />
            </Field>
            <Field label="Wnioski dotyczące IPRZ (obowiązkowe)">
              <textarea className={inputClass} rows={3} value={iprz} disabled={!editable} onChange={(e) => setIprz(e.target.value)} />
            </Field>
            {civilServant ? (
              <fieldset className="rounded-md border border-slate-200 p-3">
                <legend className="px-1 text-sm font-medium">Część III — wniosek o kolejny stopień służbowy</legend>
                <label className="flex items-center gap-2 text-sm">
                  <input
                    type="checkbox"
                    className="h-4 w-4 accent-navy-700"
                    checked={gradeRequested}
                    disabled={!editable}
                    onChange={(e) => setGradeRequested(e.target.checked)}
                  />
                  Składam wniosek o przyznanie kolejnego stopnia służbowego
                </label>
                {gradeRequested && (
                  <div className="mt-3">
                    <Field label="Umotywowanie wniosku (obowiązkowe)">
                      <textarea className={inputClass} rows={3} value={motivation} disabled={!editable} onChange={(e) => setMotivation(e.target.value)} />
                    </Field>
                  </div>
                )}
              </fieldset>
            ) : (
              <p className="text-xs text-slate-600">Część III niedostępna — oceniany nie jest urzędnikiem służby cywilnej.</p>
            )}
          </div>
        </Card>

        {editable && (
          <div className="flex flex-wrap gap-2">
            <Button variant="secondary" onClick={() => evaluate(false)} busy={busy === "draft"}>
              Zapisz szkic
            </Button>
            <Button onClick={() => evaluate(true)} busy={busy === "submit"}>
              Zatwierdź ocenę
            </Button>
          </div>
        )}
        <ProblemAlert error={error} />
        {draftSaved && !error && <Alert tone="green">Szkic zapisany.</Alert>}
        {(result || cycle.resultExplanation) && !error && <ResultBox result={result} fallback={cycle} />}
      </div>

      <div className="space-y-6 xl:col-span-2">
        <Card title="Sokratejskie AI" actions={socratic && <ModeBadge mode={socratic.mode} />}>
          <p className="text-sm text-slate-700">
            Asystent zadaje pytania „dlaczego?” i przygotowuje szkic uzasadnienia. <strong>Nigdy nie proponuje punktów.</strong>
          </p>
          <div className="mt-3">
            <Button variant="ai" onClick={askSocratic} busy={busy === "socratic"} disabled={!isEvaluator}>
              Sokratejskie AI
            </Button>
          </div>
          {socratic && (
            <div className="mt-4 space-y-4">
              <div>
                <h3 className="text-sm font-semibold text-navy-900">Pytania pomocnicze</h3>
                <ol className="mt-1 list-decimal space-y-1 pl-5 text-sm text-slate-800">
                  {socratic.socratic_questions.map((q) => (
                    <li key={q}>{q}</li>
                  ))}
                </ol>
              </div>
              <div>
                <h3 className="flex items-center gap-2 text-sm font-semibold text-navy-900">
                  Szkic uzasadnienia <Badge tone="blue">AI</Badge>
                </h3>
                <p className="mt-1 whitespace-pre-wrap rounded bg-slate-50 p-2 text-sm text-slate-800 ring-1 ring-inset ring-slate-200">
                  {socratic.draft_justification}
                </p>
                {editable && (
                  <Button variant="secondary" className="mt-2" onClick={() => setJustification(socratic.draft_justification)}>
                    Wstaw szkic do uzasadnienia (do edycji)
                  </Button>
                )}
              </div>
              <AiDisclaimer text={socratic.ai_disclaimer} />
              <MaskedPrompt prompt={socratic.masked_prompt} />
            </div>
          )}
        </Card>

        <Card title="Kontrola spójności">
          <Field label="Płeć ocenianego (do kontroli form gramatycznych)" hint="Nie jest zgadywana na podstawie imienia.">
            <select className={inputClass} value={gender} onChange={(e) => setGender(e.target.value)}>
              <option value="">nie podano</option>
              <option value="K">kobieta</option>
              <option value="M">mężczyzna</option>
            </select>
          </Field>
          <div className="mt-3">
            <Button variant="ai" onClick={checkConsistency} busy={busy === "consistency"}>
              Kontrola spójności
            </Button>
          </div>
          {consistency && (
            <div className="mt-4 space-y-2">
              {consistency.warnings.length === 0 ? (
                <Alert tone="green" title="Nie wykryto niespójności" />
              ) : (
                <ul className="space-y-2">
                  {consistency.warnings.map((w, i) => (
                    <li key={i}>
                      <Alert tone={w.severity === "ERROR" ? "red" : "amber"} title={`${w.severity === "ERROR" ? "Błąd" : "Ostrzeżenie"} · ${w.code}`}>
                        {w.message}
                      </Alert>
                    </li>
                  ))}
                </ul>
              )}
              <p className="text-xs text-slate-600">Kontrola nie zmienia treści arkusza (auto_modified: {String(consistency.auto_modified)}).</p>
            </div>
          )}
        </Card>
      </div>
    </div>
  );
}

function ResultBox({ result, fallback }: { result: EvaluationResult | null; fallback: CycleView["cycle"] }) {
  const outcome = result?.outcome ?? fallback.finalResult;
  const level = result?.level ?? fallback.performanceLevel;
  const explanation = result?.explanation ?? fallback.resultExplanation;
  if (!outcome) return null;
  return (
    <Alert tone={outcome === "POSITIVE" ? "green" : "red"} title={`Ocena ${OUTCOME_LABEL[outcome].toLowerCase()}${level ? ` · ${LEVEL_LABEL[level]}` : ""}`}>
      {explanation}
    </Alert>
  );
}
</file>

<file path="frontend/src/components/cycle/NotesTab.tsx">
"use client";

import { useState } from "react";
import { AiDisclaimer, Alert, Badge, Button, Card, Field, inputClass, MaskedPrompt, ModeBadge, ProblemAlert } from "@/components/ui";
import { useUser } from "@/components/UserProvider";
import { api } from "@/lib/api";
import { formatDate } from "@/lib/labels";
import type { HrPartnerResponse, Note } from "@/lib/types";
import type { CycleView } from "./context";

const ACTIVE = ["DRAFT_CRITERIA", "CRITERIA_CONFIRMED", "OBSERVATION", "EVALUATION_DRAFT", "AWAITING_ACK"];

export function NotesTab({ view }: { view: CycleView }) {
  const { cycle, notes, notesError, isEvaluator, refresh } = view;
  const { userName } = useUser();
  const [content, setContent] = useState("");
  const [shared, setShared] = useState(true);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<unknown>(null);

  const add = async () => {
    setBusy(true);
    setError(null);
    try {
      await api<Note>(`/api/cycles/${cycle.id}/notes`, { body: { content, isSharedAfterEval: shared } });
      setContent("");
      await refresh();
    } catch (e) {
      setError(e);
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="grid gap-6 lg:grid-cols-5">
      <div className="space-y-6 lg:col-span-3">
        <Card title="Oś czasu notatek">
          {notesError ? (
            <Alert tone="amber">Notatki widzi wyłącznie oceniający i oceniany.</Alert>
          ) : notes?.length ? (
            <ol className="relative space-y-4 border-l-2 border-slate-200 pl-5">
              {notes.map((n) => (
                <li key={n.id}>
                  <span aria-hidden className="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full bg-navy-600" />
                  <p className="text-xs text-slate-600">
                    {formatDate(n.createdAt)} · {userName(n.authorId)}{" "}
                    {n.isSharedAfterEval ? <Badge tone="blue">udostępniana po ocenie</Badge> : <Badge>prywatna</Badge>}
                  </p>
                  <p className="mt-1 text-sm text-slate-900">{n.content}</p>
                </li>
              ))}
            </ol>
          ) : (
            <p className="text-sm text-slate-700">Brak notatek.</p>
          )}
        </Card>

        {isEvaluator && ACTIVE.includes(cycle.status) && (
          <Card title="Dodaj notatkę">
            <div className="space-y-3">
              <Field label="Treść notatki (fakty, daty, zdarzenia)">
                <textarea className={inputClass} rows={3} value={content} onChange={(e) => setContent(e.target.value)} />
              </Field>
              <label className="flex items-center gap-2 text-sm">
                <input type="checkbox" className="h-4 w-4 accent-navy-700" checked={shared} onChange={(e) => setShared(e.target.checked)} />
                Udostępnij ocenianemu po zakończeniu oceny (<code>isSharedAfterEval</code>)
              </label>
              <ProblemAlert error={error} />
              <Button onClick={add} busy={busy} disabled={!content.trim()}>
                Dodaj notatkę
              </Button>
            </div>
          </Card>
        )}
      </div>

      <div className="lg:col-span-2">
        <HrPartnerPanel notes={(notes ?? []).map((n) => n.content)} disabled={!!notesError} />
      </div>
    </div>
  );
}

function HrPartnerPanel({ notes, disabled }: { notes: string[]; disabled: boolean }) {
  const [overtime, setOvertime] = useState("22");
  const [projects, setProjects] = useState("3");
  const [trainings, setTrainings] = useState("1");
  const [result, setResult] = useState<HrPartnerResponse | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<unknown>(null);

  const analyze = async () => {
    setBusy(true);
    setError(null);
    try {
      setResult(
        await api<HrPartnerResponse>("/api/ai/hr-partner", {
          body: {
            notes,
            workload_signals: {
              overtime_hours: Number(overtime) || 0,
              concurrent_projects: Number(projects) || 0,
              missed_trainings: Number(trainings) || 0,
            },
          },
        }),
      );
    } catch (e) {
      setError(e);
    } finally {
      setBusy(false);
    }
  };

  return (
    <Card title="Wirtualny HR Partner" actions={result && <ModeBadge mode={result.mode} />}>
      <div className="grid grid-cols-3 gap-2">
        <Field label="Nadgodziny / mies.">
          <input type="number" min={0} className={inputClass} value={overtime} onChange={(e) => setOvertime(e.target.value)} />
        </Field>
        <Field label="Projekty równolegle">
          <input type="number" min={0} className={inputClass} value={projects} onChange={(e) => setProjects(e.target.value)} />
        </Field>
        <Field label="Pominięte szkolenia">
          <input type="number" min={0} className={inputClass} value={trainings} onChange={(e) => setTrainings(e.target.value)} />
        </Field>
      </div>
      <div className="mt-3">
        <Button variant="ai" onClick={analyze} busy={busy} disabled={disabled}>
          Analizuj z Wirtualnym HR Partnerem
        </Button>
      </div>
      <div className="mt-4 space-y-4">
        <ProblemAlert error={error} />
        {result && (
          <>
            {result.burnout_risk_signal ? (
              <Alert tone="amber" title="⚠️ Sygnał ryzyka przeciążenia">
                Warto porozmawiać o obciążeniu. To sygnał organizacyjny, nie diagnoza.
              </Alert>
            ) : (
              <Alert tone="green" title="Brak sygnału przeciążenia" />
            )}
            <Section title="Jak zacząć rozmowę" items={result.conversation_starters} />
            <Section title="Rekomendacje organizacyjne" items={result.organizational_suggestions} />
            <div>
              <h3 className="text-sm font-semibold text-navy-900">Moment docenienia</h3>
              <p className="mt-1 text-sm text-slate-800">{result.appreciation_moment}</p>
            </div>
            <MaskedPrompt prompt={result.masked_prompt} />
            <AiDisclaimer text={result.ai_disclaimer} />
          </>
        )}
      </div>
    </Card>
  );
}

function Section({ title, items }: { title: string; items: string[] }) {
  return (
    <div>
      <h3 className="text-sm font-semibold text-navy-900">{title}</h3>
      <ul className="mt-1 list-disc space-y-1 pl-5 text-sm text-slate-800">
        {items.map((i) => (
          <li key={i}>{i}</li>
        ))}
      </ul>
    </div>
  );
}
