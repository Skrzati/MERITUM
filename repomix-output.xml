"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import { useState } from "react";
import { AckTab } from "@/components/cycle/AckTab";
import type { CycleView } from "@/components/cycle/context";
import { CriteriaTab } from "@/components/cycle/CriteriaTab";
import { EvaluationTab } from "@/components/cycle/EvaluationTab";
import { NotesTab } from "@/components/cycle/NotesTab";
import { ProgressSteps } from "@/components/cycle/ProgressSteps";
import { Badge, Card, ProblemAlert, Spinner } from "@/components/ui";
import { useUser } from "@/components/UserProvider";
import { api, ApiError } from "@/lib/api";
import { formatDate, LEVEL_LABEL, OUTCOME_LABEL, STATUS_LABEL, STATUS_TONE } from "@/lib/labels";
import type { Cycle, Note, Schema } from "@/lib/types";
import { useAsync } from "@/lib/useAsync";

const TABS = [
  { id: "criteria", label: "Kryteria" },
  { id: "notes", label: "Notatki i Wirtualny HR Partner" },
  { id: "evaluation", label: "Ocena i Sokratejskie AI" },
  { id: "ack", label: "Zapoznanie, sprzeciw i PDF" },
] as const;
type TabId = (typeof TABS)[number]["id"];

interface Loaded {
  cycle: Cycle;
  schema: Schema | null;
  notes: Note[] | null;
  notesError: unknown;
}

export default function CyclePage() {
  const { id } = useParams<{ id: string }>();
  const { current, userName, userById } = useUser();
  const [tab, setTab] = useState<TabId>("criteria");

  const state = useAsync<Loaded | null>(async () => {
    if (!current) return null;
    const cycle = await api<Cycle>(`/api/cycles/${id}`);
    const [schema, notesResult] = await Promise.all([
      api<Schema>(`/api/schemas/${cycle.schemaVersionId}`).catch(() => null),
      api<Note[]>(`/api/cycles/${id}/notes`).then(
        (notes) => ({ notes, error: null as unknown }),
        (error: unknown) => ({ notes: null, error }),
      ),
    ]);
    return { cycle, schema, notes: notesResult.notes, notesError: notesResult.error };
  }, [id, current?.id]);

  if (!current || (state.loading && !state.data)) return <Spinner />;
  if (state.error) {
    return (
      <div className="space-y-4">
        <ProblemAlert error={state.error} />
        {state.error instanceof ApiError && state.error.status === 403 && (
          <p className="text-sm">Ten cykl nie jest dostępny dla aktywnego użytkownika — przełącz rolę w nagłówku.</p>
        )}
        <Link href="/" className="text-sm font-medium text-navy-700 underline">
          ← Wróć do pulpitu
        </Link>
      </div>
    );
  }
  if (!state.data) return null;

  const { cycle } = state.data;
  const view: CycleView = {
    ...state.data,
    me: current,
    employee: userById(cycle.employeeId),
    isEvaluator: current.id === cycle.evaluatorId,
    isEmployee: current.id === cycle.employeeId,
    isOfficeHr: current.role === "HR" && current.officeId === cycle.officeId,
    isOfficeDg: current.role === "DG" && current.officeId === cycle.officeId,
    refresh: state.reload,
  };
  const myRole = view.isEvaluator ? "oceniający" : view.isEmployee ? "oceniany" : view.isOfficeDg ? "DG" : view.isOfficeHr ? "kadry" : "podgląd";

  return (
    <div className="space-y-6">
      <Link href="/" className="text-sm font-medium text-navy-700 underline">
        ← Pulpit
      </Link>
      <Card>
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 className="text-2xl font-bold text-navy-900">
              Ocena okresowa: {userName(cycle.employeeId)}
            </h1>
            <p className="mt-1 text-sm text-slate-700">
              Arkusz {cycle.sheetType}
              {state.data.schema?.config.sheetTypes?.[cycle.sheetType] ? ` — ${state.data.schema.config.sheetTypes[cycle.sheetType]}` : ""}
              {" · "}oceniający: {userName(cycle.evaluatorId)} · okres {formatDate(cycle.startDate)} – {formatDate(cycle.dueDate)}
            </p>
          </div>
          <div className="flex flex-wrap items-center gap-2">
            <Badge tone={STATUS_TONE[cycle.status]}>{STATUS_LABEL[cycle.status]}</Badge>
            <Badge>schemat {state.data.schema?.versionCode ?? `#${cycle.schemaVersionId}`}</Badge>
            <Badge tone="blue">Twoja rola: {myRole}</Badge>
            {cycle.finalResult && (
              <Badge tone={cycle.finalResult === "POSITIVE" ? "green" : "red"}>
                {OUTCOME_LABEL[cycle.finalResult]}
                {cycle.performanceLevel ? ` · ${LEVEL_LABEL[cycle.performanceLevel]}` : ""}
              </Badge>
            )}
          </div>
        </div>
        <div className="mt-5">
          <ProgressSteps status={cycle.status} />
        </div>
      </Card>

      <div role="tablist" aria-label="Sekcje cyklu" className="flex flex-wrap gap-1 border-b border-slate-200">
        {TABS.map((t) => (
          <button
            key={t.id}
            role="tab"
            id={`tab-${t.id}`}
            aria-selected={tab === t.id}
            aria-controls={`panel-${t.id}`}
            onClick={() => setTab(t.id)}
            className={`-mb-px rounded-t-md border px-4 py-2 text-sm font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-navy-600 ${
              tab === t.id ? "border-slate-200 border-b-white bg-white text-navy-900" : "border-transparent text-slate-700 hover:text-navy-900"
            }`}
          >
            {t.label}
          </button>
        ))}
      </div>
      <div role="tabpanel" id={`panel-${tab}`} aria-labelledby={`tab-${tab}`}>
        {tab === "criteria" && <CriteriaTab view={view} />}
        {tab === "notes" && <NotesTab view={view} />}
        {tab === "evaluation" && <EvaluationTab view={view} />}
        {tab === "ack" && <AckTab view={view} />}
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/app/hr/page.tsx">
"use client";

import { useState } from "react";
import { RoleGate } from "@/components/RoleGate";
import { Alert, Badge, Button, Card, Field, inputClass, ProblemAlert, Spinner } from "@/components/ui";
import { useUser } from "@/components/UserProvider";
import { api, saveBlob } from "@/lib/api";
import { formatDate, ROLE_LABEL, today } from "@/lib/labels";
import type { Cycle, HandoverResult, ImportResult, User } from "@/lib/types";
import { useAsync } from "@/lib/useAsync";

type SortKey = "fullName" | "email" | "role" | "id";

export default function HrPage() {
  return (
    <RoleGate roles={["HR"]}>
      <HrPanel />
    </RoleGate>
  );
}

function HrPanel() {
  const { current, reloadUsers } = useUser();
  const [query, setQuery] = useState("");
  const [sort, setSort] = useState<SortKey>("fullName");
  const [dir, setDir] = useState<"ASC" | "DESC">("ASC");
  const employees = useAsync(
    () => api<User[]>(`/api/hr/employees?q=${encodeURIComponent(query)}&sort=${sort}&dir=${dir}`),
    [query, sort, dir, current?.id],
  );
  const list = employees.data ?? [];

  const [exportError, setExportError] = useState<unknown>(null);
  const gdprExport = async (u: User) => {
    setExportError(null);
    try {
      const data = await api<unknown>(`/api/hr/employees/${u.id}/gdpr-export`);
      saveBlob(new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }), `rodo-art15-${u.id}.json`);
    } catch (e) {
      setExportError(e);
    }
  };

  const refreshAll = async () => {
    await Promise.all([employees.reload(), reloadUsers()]);
  };

  return (
    <div className="space-y-6">
      <h1 className="text-2xl font-bold text-navy-900">Panel Kadr</h1>

      <Card title="Pracownicy urzędu">
        <div className="mb-4 grid gap-3 sm:grid-cols-3">
          <Field label="Szukaj (imię, nazwisko, e-mail)">
            <input type="search" className={inputClass} value={query} onChange={(e) => setQuery(e.target.value)} />
          </Field>
          <Field label="Sortuj według">
            <select className={inputClass} value={sort} onChange={(e) => setSort(e.target.value as SortKey)}>
              <option value="fullName">Imię i nazwisko</option>
              <option value="email">E-mail</option>
              <option value="role">Rola</option>
              <option value="id">ID</option>
            </select>
          </Field>
          <Field label="Kierunek">
            <select className={inputClass} value={dir} onChange={(e) => setDir(e.target.value as "ASC" | "DESC")}>
              <option value="ASC">rosnąco</option>
              <option value="DESC">malejąco</option>
            </select>
          </Field>
        </div>
        {employees.loading && <Spinner />}
        <ProblemAlert error={employees.error ?? exportError} />
        <div className="overflow-x-auto">
          <table className="w-full text-left text-sm">
            <caption className="sr-only">Pracownicy</caption>
            <thead className="border-b border-slate-200 text-xs uppercase text-slate-600">
              <tr>
                <th className="py-2 pr-3">Imię i nazwisko</th>
                <th className="py-2 pr-3">E-mail</th>
                <th className="py-2 pr-3">Rola</th>
                <th className="py-2 pr-3">Status SC</th>
                <th className="py-2" />
              </tr>
            </thead>
            <tbody>
              {list.map((u) => (
                <tr key={u.id} className="border-b border-slate-100 last:border-0">
                  <td className="py-2 pr-3 font-medium">{u.fullName}</td>
                  <td className="py-2 pr-3">{u.email}</td>
                  <td className="py-2 pr-3">{ROLE_LABEL[u.role]}</td>
                  <td className="py-2 pr-3">{u.civilServant ? <Badge tone="blue">urzędnik SC</Badge> : <Badge>pracownik SC</Badge>}</td>
                  <td className="py-2 text-right">
                    <Button variant="secondary" onClick={() => gdprExport(u)}>
                      Eksport RODO (art. 15)
                    </Button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>

      <div className="grid gap-6 lg:grid-cols-3">
        <AbsenceForm employees={list} />
        <HandoverForm employees={list} onDone={refreshAll} />
        <CsvImport onDone={refreshAll} />
      </div>
    </div>
  );
}

function AbsenceForm({ employees }: { employees: User[] }) {
  const [userId, setUserId] = useState("");
  const [start, setStart] = useState(today());
  const [end, setEnd] = useState(today());
  const [reason, setReason] = useState("Zwolnienie lekarskie");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<unknown>(null);
  const [cycles, setCycles] = useState<Cycle[] | null>(null);

  const submit = async () => {
    setBusy(true);
    setError(null);
    try {
      setCycles(await api<Cycle[]>("/api/hr/absences", { body: { userId: Number(userId), startDate: start, endDate: end, reason } }));
    } catch (e) {
      setError(e);
    } finally {
      setBusy(false);
    }
  };

  return (
    <Card title="Rejestracja nieobecności">
      <div className="space-y-3">
        <EmployeeSelect employees={employees} value={userId} onChange={setUserId} />
        <div className="grid grid-cols-2 gap-2">
          <Field label="Od">
            <input type="date" className={inputClass} value={start} onChange={(e) => setStart(e.target.value)} />
          </Field>
          <Field label="Do">
            <input type="date" className={inputClass} value={end} onChange={(e) => setEnd(e.target.value)} />
          </Field>
        </div>
        <Field label="Przyczyna">
          <input className={inputClass} value={reason} onChange={(e) => setReason(e.target.value)} />
        </Field>
        <p className="text-xs text-slate-600">Ciągła nieobecność dłuższa niż 1 miesiąc przedłuża termin oceny okresowej (art. 81 ust. 7).</p>
        <Button onClick={submit} busy={busy} disabled={!userId}>
          Zarejestruj i przelicz termin
        </Button>
        <ProblemAlert error={error} />
        {cycles && (
          <Alert tone="green" title="Przeliczone terminy aktywnych cykli">
            {cycles.length === 0 ? "Brak aktywnych cykli." : cycles.map((c) => <p key={c.id}>Cykl #{c.id}: nowy termin {formatDate(c.dueDate)}</p>)}
          </Alert>
        )}
      </div>
    </Card>
  );
}

function HandoverForm({ employees, onDone }: { employees: User[]; onDone: () => Promise<void> }) {
  const [employeeId, setEmployeeId] = useState("");
  const [evaluatorId, setEvaluatorId] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<unknown>(null);
  const [result, setResult] = useState<HandoverResult | null>(null);
  const evaluators = employees.filter((u) => u.role === "EVALUATOR" || u.role === "DG");

  const submit = async () => {
    setBusy(true);
    setError(null);
    try {
      setResult(await api<HandoverResult>("/api/hr/handover", { body: { employeeId: Number(employeeId), newEvaluatorId: Number(evaluatorId) } }));
      await onDone();
    } catch (e) {
      setError(e);
    } finally {
      setBusy(false);
    }
  };

  return (
    <Card title="Zmiana przełożonego (Handover)">
      <div className="space-y-3">
        <EmployeeSelect employees={employees} value={employeeId} onChange={setEmployeeId} />
        <Field label="Nowy oceniający">
          <select className={inputClass} value={evaluatorId} onChange={(e) => setEvaluatorId(e.target.value)}>
            <option value="">— wybierz —</option>
            {evaluators.map((u) => (
              <option key={u.id} value={u.id}>
                {u.fullName} ({ROLE_LABEL[u.role]})
              </option>
            ))}
          </select>
        </Field>
        <p className="text-xs text-slate-600">§ 9 ust. 3: nowy przełożony przejmuje aktywny cykl i notatki, kryteria pozostają bez zmian.</p>
        <Button onClick={submit} busy={busy} disabled={!employeeId || !evaluatorId}>
          Przekaż cykl
        </Button>
        <ProblemAlert error={error} />
        {result && (
          <Alert tone="green" title="Przekazano">
            Cykle: {result.cycleIds.length ? result.cycleIds.map((id) => `#${id}`).join(", ") : "brak aktywnych"} · notatek: {result.notesTransferred}
          </Alert>
        )}
      </div>
    </Card>
  );
}

function CsvImport({ onDone }: { onDone: () => Promise<void> }) {
  const [file, setFile] = useState<File | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<unknown>(null);
  const [result, setResult] = useState<ImportResult | null>(null);

  const submit = async () => {
    if (!file) return;
    setBusy(true);
    setError(null);
    try {
      const form = new FormData();
      form.append("file", file);
      setResult(await api<ImportResult>("/api/hr/import-csv", { form }));
      await onDone();
    } catch (e) {
      setError(e);
    } finally {
      setBusy(false);
    }
  };

  return (
    <Card title="Import pracowników (CSV)">
      <div className="space-y-3">
        <Field label="Plik CSV" hint="Kolumny: full_name,email,role,is_civil_servant[,supervisor_email]">
          <input type="file" accept=".csv,text/csv" className="block w-full text-sm" onChange={(e) => setFile(e.target.files?.[0] ?? null)} />
        </Field>
        <Button onClick={submit} busy={busy} disabled={!file}>
          Importuj
        </Button>
        <ProblemAlert error={error} />
        {result && (
          <Alert tone={result.errors.length ? "amber" : "green"} title={`Zaimportowano: ${result.imported}`}>
            {[...result.skipped, ...result.errors].map((m) => (
              <p key={m}>{m}</p>
            ))}
          </Alert>
        )}
      </div>
    </Card>
  );
}

function EmployeeSelect({ employees, value, onChange }: { employees: User[]; value: string; onChange: (v: string) => void }) {
  return (
    <Field label="Pracownik">
      <select className={inputClass} value={value} onChange={(e) => onChange(e.target.value)}>
        <option value="">— wybierz —</option>
        {employees.map((u) => (
          <option key={u.id} value={u.id}>
            {u.fullName}
          </option>
        ))}
      </select>
    </Field>
  );
}
</file>

