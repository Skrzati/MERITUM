<file path="backend-core/src/main/java/pl/gov/kprm/oceny/export/CsvReportRenderer.java">
package pl.gov.kprm.oceny.export;

import pl.gov.kprm.oceny.rules.AnonymizedCount;

import java.util.List;

/** CSV dla Excela: UTF-8 z BOM, separator „;” (polskie ustawienia regionalne), CRLF; liczności ukryte jako „<k”. */
public final class CsvReportRenderer {
    public static final String BOM = "\uFEFF";
    private static final String SEPARATOR = ";";
    private static final String CRLF = "\r\n";

    public record Row(String section, String key, AnonymizedCount count) {
    }

    private CsvReportRenderer() {
    }

    public static String render(List<Row> rows, int k) {
        StringBuilder out = new StringBuilder(BOM).append("sekcja;kategoria;liczba").append(CRLF);
        for (Row row : rows) {
            String value = row.count().suppressed() ? "<" + k : String.valueOf(row.count().value());
            out.append(cell(row.section())).append(SEPARATOR).append(cell(row.key())).append(SEPARATOR)
                    .append(cell(value)).append(CRLF);
        }
        return out.toString();
    }

    static String cell(String value) {
        String v = value == null ? "" : value;
        if (!v.isEmpty() && "=+-@".indexOf(v.charAt(0)) >= 0) {
            v = "'" + v; // ochrona przed wstrzyknięciem formuły w Excelu
        }
        return v.contains(SEPARATOR) || v.contains("\"") || v.contains("\n") ? "\"" + v.replace("\"", "\"\"") + "\"" : v;
    }
}
</file>

<file path="backend-core/src/main/java/pl/gov/kprm/oceny/export/IcsCalendarRenderer.java">
package pl.gov.kprm.oceny.export;

import java.nio.charset.StandardCharsets;
import java.time.Instant;
import java.time.LocalDate;
import java.time.LocalTime;
import java.time.ZoneId;
import java.time.ZoneOffset;
import java.time.format.DateTimeFormatter;
import java.util.List;

/** Zaproszenie iCalendar (RFC 5545): CRLF, escapowanie tekstu, zawijanie linii do 75 oktetów, czas w UTC. */
public final class IcsCalendarRenderer {
    private static final String CRLF = "\r\n";
    private static final int MAX_LINE_OCTETS = 75;
    private static final DateTimeFormatter UTC_FORMAT =
            DateTimeFormatter.ofPattern("yyyyMMdd'T'HHmmss'Z'").withZone(ZoneOffset.UTC);

    public record Attendee(String name, String email) {
    }

    public record Invitation(String uid, Instant stamp, LocalDate date, LocalTime start, int durationMinutes,
                             ZoneId zone, String summary, String description, String location,
                             Attendee organizer, List<Attendee> attendees) {
    }

    private IcsCalendarRenderer() {
    }

    public static String render(Invitation inv) {
        Instant start = inv.date().atTime(inv.start()).atZone(inv.zone()).toInstant();
        Instant end = start.plusSeconds(inv.durationMinutes() * 60L);
        StringBuilder out = new StringBuilder();
        line(out, "BEGIN:VCALENDAR");
        line(out, "VERSION:2.0");
        line(out, "PRODID:-//KPRM//MERITUM//PL");
        line(out, "CALSCALE:GREGORIAN");
        line(out, "METHOD:REQUEST");
        line(out, "BEGIN:VEVENT");
        line(out, "UID:" + inv.uid());
        line(out, "DTSTAMP:" + UTC_FORMAT.format(inv.stamp()));
        line(out, "DTSTART:" + UTC_FORMAT.format(start));
        line(out, "DTEND:" + UTC_FORMAT.format(end));
        line(out, "SUMMARY:" + escape(inv.summary()));
        line(out, "DESCRIPTION:" + escape(inv.description()));
        if (inv.location() != null && !inv.location().isBlank()) {
            line(out, "LOCATION:" + escape(inv.location()));
        }
        line(out, "ORGANIZER;CN=" + param(inv.organizer().name()) + ":mailto:" + inv.organizer().email());
        for (Attendee a : inv.attendees()) {
            line(out, "ATTENDEE;CN=" + param(a.name()) + ";ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=TRUE:mailto:"
                    + a.email());
        }
        line(out, "STATUS:CONFIRMED");
        line(out, "END:VEVENT");
        line(out, "END:VCALENDAR");
        return out.toString();
    }

    static String escape(String text) {
        return text == null ? "" : text.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
                .replace("\r\n", "\\n").replace("\n", "\\n");
    }

    private static String param(String value) {
        return "\"" + value.replace("\"", "'") + "\"";
    }

    /** Zawija linię tak, by żadna nie przekroczyła 75 oktetów UTF-8 (bez dzielenia znaku wielobajtowego). */
    private static void line(StringBuilder out, String content) {
        int octets = 0;
        int limit = MAX_LINE_OCTETS;
        for (int i = 0; i < content.length(); ) {
            int cp = content.codePointAt(i);
            int size = new String(Character.toChars(cp)).getBytes(StandardCharsets.UTF_8).length;
            if (octets + size > limit) {
                out.append(CRLF).append(' ');
                octets = 0;
                limit = MAX_LINE_OCTETS - 1;
            }
            out.appendCodePoint(cp);
            octets += size;
            i += Character.charCount(cp);
        }
        out.append(CRLF);
    }
}
</file>

<file path="backend-core/src/main/java/pl/gov/kprm/oceny/pdf/GotenbergClient.java">
package pl.gov.kprm.oceny.pdf;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.io.ByteArrayResource;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.http.HttpEntity;
import org.springframework.http.HttpHeaders;
import org.springframework.util.LinkedMultiValueMap;
import org.springframework.util.MultiValueMap;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestClient;
import org.springframework.web.client.RestClientException;
import org.springframework.web.server.ResponseStatusException;

import java.nio.charset.StandardCharsets;

/** Konwersja HTML -> PDF/A przez Gotenberg (Chromium). */
@Component
public class GotenbergClient {
    static final String PDF_A_FORMAT = "PDF/A-2b";
    private static final String A4_WIDTH_IN = "8.27";
    private static final String A4_HEIGHT_IN = "11.7";
    private static final String NO_MARGIN = "0";

    private final RestClient http;
    private final String convertUrl;

    public GotenbergClient(RestClient.Builder builder, @Value("${app.gotenberg-url}") String convertUrl) {
        this.http = builder.build();
        this.convertUrl = convertUrl;
    }

    public byte[] htmlToPdf(String html) {
        HttpHeaders fileHeaders = new HttpHeaders();
        fileHeaders.setContentType(new MediaType(MediaType.TEXT_HTML, StandardCharsets.UTF_8));
        MultiValueMap<String, Object> body = new LinkedMultiValueMap<>();
        body.add("files", new HttpEntity<>(new NamedResource(html.getBytes(StandardCharsets.UTF_8), "index.html"),
                fileHeaders));
        body.add("pdfa", PDF_A_FORMAT);
        body.add("pdfua", "true");
        body.add("preferCssPageSize", "true");
        body.add("printBackground", "true");
        body.add("paperWidth", A4_WIDTH_IN);
        body.add("paperHeight", A4_HEIGHT_IN);
        for (String side : new String[]{"marginTop", "marginBottom", "marginLeft", "marginRight"}) {
            body.add(side, NO_MARGIN);
        }
        try {
            return http.post().uri(convertUrl)
                    .contentType(MediaType.MULTIPART_FORM_DATA)
                    .body(body)
                    .retrieve()
                    .body(byte[].class);
        } catch (RestClientException e) {
            throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE, "Generator PDF (Gotenberg) niedostępny", e);
        }
    }

    private static final class NamedResource extends ByteArrayResource {
        private final String filename;

        NamedResource(byte[] bytes, String filename) {
            super(bytes);
            this.filename = filename;
        }

        @Override
        public String getFilename() {
            return filename;
        }
    }
}
</file>

